<%
    let type = "post";
    if (is_home()) type = "index";
    if (is_post() || is_page()) type = "post";
    if (is_category() || page.type === "categories") type = "categories";
    if (is_tag() || page.type === "tags") type = "tags";
    if (is_archive()) type = "archives";
    let title = page.title + " | " + config.title;
    if (is_home()) title = config.title;
    if (is_post() || is_page()) title = page.title + " | " + config.title;
    if (is_category()) title = "Categories: " + page.category + " | " + config.title;
    if (is_tag()) title = "Tags: " + page.tag + " | " + config.title;
    if (is_archive()) title = "Archives | " + config.title;
%>
<!DOCTYPE html>
<html lang="<%- config.language %>">
<head>
    <meta charset="utf-8" />
    <script>
        try {
            const savedTheme = localStorage.getItem("theme");

            if (savedTheme === "dark") {
                document.documentElement.classList.add("dark-mode");
            }
        } catch (e) {}
    </script>
    <title><%= title %></title>
    <meta name="author" content="<%- config.author %>" />
    <meta name="description" content="<%- config.description %>" />
    <meta name="keywords" content="<%- config.keywords %>" />
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />
    <link rel="icon" href="<%- url_for(theme.avatar) %>" />
    <%- partial("import", { type }) %>
    <%
        const metaTitle = is_home() ? config.title : page.title + " | " + config.title;
        const metaDescription = page.description || config.description || "YCC1203's Blog";
        const metaUrl = config.url ? config.url + url_for(page.path || "/") : "";
        const metaImage = config.url ? config.url + url_for("/images/og-image.jpg") : "";
    %>

    <meta property="og:title" content="<%- metaTitle %>" />
    <meta property="og:description" content="<%- metaDescription %>" />
    <meta property="og:type" content="<%= is_post() ? 'article' : 'website' %>" />
    <meta property="og:url" content="<%- metaUrl %>" />
    <meta property="og:image" content="<%- metaImage %>" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="<%- metaTitle %>" />
    <meta name="twitter:description" content="<%- metaDescription %>" />
    <meta name="twitter:image" content="<%- metaImage %>" />
</head>
<body>
    <% if (is_post()) { %>
    <div id="reading-progress"></div>
    <% } %>
    <div id="layout">
        <transition name="fade">
            <div id="loading" v-show="loading">
                <div id="loading-circle">
                    <h2>LOADING</h2>
                    <p>加載中，請稍候...</p>
                    <img src="<%- url_for(theme.loading) %>" />
                </div>
            </div>
        </transition>
        <%- partial("menu") %>
        <div id="main" :class="loading ? 'into-enter-from': 'into-enter-active'">
            <%- partial(type) %>
            <%- partial("footer") %>
        </div>
        <% if (theme.preview.enable) { %>
        <transition name="fade">
            <div id="preview" ref="preview" v-show="previewShow">
                <img id="preview-content" ref="previewContent" />
            </div>
        </transition>
        <% } %>
    </div>
    <script src="<%- url_for("/js/main.js") %>"></script>
    <% if (type === "post" && page.comments) { %>
    <%- partial("comment") %>
    <% } %>

    <!-- 點擊煙火效果 -->
    <canvas
        id="fireworks"
        style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: 32767"
    ></canvas>

    <script src="https://cdn.jsdelivr.net/npm/animejs@3.2.1/lib/anime.min.js"></script>
    <script src="<%- url_for('/js/fireworks.min.js') %>"></script>

    <!-- 背景粒子效果 -->
    <canvas
        id="background"
        style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: -1"
    ></canvas>

    <script src="<%- url_for('/js/background.min.js') %>"></script>

    <!-- 自訂滑鼠游標 -->
    <div id="cursor"></div>
    <link rel="stylesheet" href="<%- url_for('/css/cursor.min.css') %>" />
    <script src="<%- url_for('/js/cursor.min.js') %>"></script>

    <% if (is_post()) { %>
    <script src="<%- url_for('/js/toc.js') %>"></script>
    <script src="<%- url_for('/js/mobile-toc.js') %>"></script>
    <% } %>

    <!-- 回到頂部按鈕 -->
    <button id="back-to-top" aria-label="回到頂部">
        <i class="fa-solid fa-arrow-up"></i>
    </button>

    <script src="<%- url_for('/js/back-to-top.js') %>"></script>

    <% if (is_post()) { %>
    <script src="<%- url_for('/js/reading-progress.js') %>"></script>
    <% } %>

    <!-- 深色模式切換 -->
    <button id="theme-toggle" aria-label="切換深色模式">
    <i class="fa-solid fa-moon"></i>
    </button>

    <script src="<%- url_for('/js/theme-toggle.js') %>"></script>

    <script
        src="https://cdn.busuanzi.cc/busuanzi/3.6.9/busuanzi.min.js"
        defer>
    </script>

    <script src="<%- url_for('/js/search-shortcut.js') %>"></script>

    <script src="<%- url_for('/js/404-search.js') %>"></script>

    <% if (is_post()) { %>
    <script src="<%- url_for('/js/copy-code.js') %>"></script>
    <script src="<%- url_for('/js/heading-anchor.js') %>"></script>
    <script src="<%- url_for('/js/image-lightbox.js') %>"></script>
    <% } %>

    <% if (page.path === "projects/index.html") { %>
    <script src="<%- url_for('/js/project-progress.js') %>"></script>
    <% } %>
</body>
</html>
